generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}
enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
  EXPIRED
  REFUNDED
}
enum LedgerDirection {
  DEBIT
  CREDIT
}
model Customer {
  id String @id @default(cuid())
  email String @unique
  name String?
  createdAt DateTime @default(now())
  orders Order[]
  wallet CustomerWallet?
  onRampIntents OnRampIntent[]
  cryptoTransactions CryptoTransaction[]
  creditReservations CreditReservation[]
  eligibility CustomerEligibility?
}
model Product {
  id String @id @default(cuid())
  sku String @unique
  slug String @unique
  name String
  active Boolean @default(false)
  priceCents Int
  inventory Int @default(0)
  lots Lot[]
}
model Lot {
  id String @id @default(cuid())
  code String @unique
  productId String
  product Product @relation(fields:[productId], references:[id])
  coaKey String
  purity Decimal @db.Decimal(5,2)
  releasedAt DateTime @default(now())
  coas Coa[]
}
model Order {
  id String @id @default(cuid())
  customerId String
  customer Customer @relation(fields:[customerId], references:[id])
  status OrderStatus @default(PENDING_PAYMENT)
  totalCents Int
  currency String @default("USD")
  researchAcknowledgedAt DateTime?
  createdAt DateTime @default(now())
  // Client-supplied Idempotency-Key, scoped to the owning customer. NULL for orders created internally.
  idempotencyKey String?
  // SHA-256 of the canonical request payload; a replay with the same key must match it.
  requestHash String?
  items OrderItem[]
  payment Payment?
  creditReservation CreditReservation?
  // Snapshot of where to ship, exactly as the customer entered it at order time (free text today). NULL only for orders created before this column existed.
  shippingAddress String?
  shipments Shipment[]
  events OrderEvent[]
  @@unique([customerId, idempotencyKey])
}
model OrderItem {
  id String @id @default(cuid())
  orderId String
  order Order @relation(fields:[orderId], references:[id])
  productId String
  lotCode String
  quantity Int
  unitCents Int
}
model Payment {
  id String @id @default(cuid())
  orderId String @unique
  order Order @relation(fields:[orderId], references:[id])
  provider String
  status PaymentStatus @default(PENDING)
  amountAtomic String
  currency String
  walletAddress String?
  txSignature String? @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  ledgerEntries LedgerEntry[]
}
model LedgerEntry {
  id String @id @default(cuid())
  paymentId String
  payment Payment @relation(fields:[paymentId], references:[id])
  account String
  direction LedgerDirection
  amountAtomic String
  currency String
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// User-owned wallet and Research Credits domain.
// Token amounts are BigInt USDC base units (6 decimals). Research Credits are a
// derived display unit and are intentionally NOT stored as an issued balance.
// No column here may hold private keys, seed phrases, or signing material.
// ---------------------------------------------------------------------------
enum OnRampStatus {
  CREATED
  PENDING
  COMPLETED
  FAILED
  EXPIRED
}
enum CryptoTxType {
  DEPOSIT
  WITHDRAWAL
  PURCHASE
  REFUND
}
enum CryptoTxStatus {
  PREPARED
  SUBMITTED
  CONFIRMED
  FINALIZED
  FAILED
  EXPIRED
}
enum ReservationStatus {
  ACTIVE
  CONSUMED
  RELEASED
  EXPIRED
}

model CustomerWallet {
  id String @id @default(cuid())
  customerId String @unique
  customer Customer @relation(fields:[customerId], references:[id])
  address String @unique
  provider String
  network String
  createdAt DateTime @default(now())
  snapshots BalanceSnapshot[]
  permissions DelegatedPermission[]
}
model BalanceSnapshot {
  id String @id @default(cuid())
  walletId String
  wallet CustomerWallet @relation(fields:[walletId], references:[id])
  mint String
  amountAtomic BigInt
  slot BigInt?
  observedAt DateTime @default(now())
  @@index([walletId, observedAt])
}
model OnRampIntent {
  id String @id @default(cuid())
  customerId String
  customer Customer @relation(fields:[customerId], references:[id])
  provider String
  status OnRampStatus @default(CREATED)
  intendedUsdCents Int
  destinationAddress String
  externalReference String? @unique
  // Set only for intents created by POST /v1/wallet/onramp/order-topup. Informational link; never credits anything.
  orderId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([customerId, createdAt])
  @@index([customerId, orderId, status])
}
model CryptoTransaction {
  id String @id @default(cuid())
  customerId String
  customer Customer @relation(fields:[customerId], references:[id])
  type CryptoTxType
  status CryptoTxStatus @default(PREPARED)
  amountAtomic BigInt
  feeLamports BigInt?
  sourceAddress String
  destinationAddress String
  mint String
  network String
  reference String @unique
  orderId String?
  txSignature String? @unique
  failureReason String?
  createdAt DateTime @default(now())
  finalizedAt DateTime?
  @@index([customerId, createdAt])
  @@index([status])
}
model CreditReservation {
  id String @id @default(cuid())
  customerId String
  customer Customer @relation(fields:[customerId], references:[id])
  orderId String @unique
  order Order @relation(fields:[orderId], references:[id])
  amountAtomic BigInt
  status ReservationStatus @default(ACTIVE)
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([customerId, status])
}
// Design-only in this phase: gated by ENABLE_DELEGATED_PAYMENTS (default false).
model DelegatedPermission {
  id String @id @default(cuid())
  walletId String
  wallet CustomerWallet @relation(fields:[walletId], references:[id])
  merchantAddress String
  capAtomic BigInt
  spentAtomic BigInt @default(0)
  expiresAt DateTime
  consentedAt DateTime
  revokedAt DateTime?
  @@index([walletId])
}
model WalletAuditEvent {
  id String @id @default(cuid())
  customerId String
  action String
  detail Json?
  createdAt DateTime @default(now())
  @@index([customerId, createdAt])
}

// ---------------------------------------------------------------------------
// Customer purchase eligibility. A persisted, reviewer-controlled record that is
// deliberately separate from Order.researchAcknowledgedAt (a per-order attestation).
// Customers may only create/refresh a PENDING request; APPROVED/REJECTED are set by an
// admin-token-protected review endpoint.
// ---------------------------------------------------------------------------
enum EligibilityStatus {
  PENDING
  APPROVED
  REJECTED
}
model CustomerEligibility {
  id String @id @default(cuid())
  customerId String @unique
  customer Customer @relation(fields:[customerId], references:[id])
  status EligibilityStatus @default(PENDING)
  requestedAt DateTime @default(now())
  reviewedAt DateTime?
  reviewedBy String?
  notes String?
}

// ---------------------------------------------------------------------------
// Back office: admin accounts, sessions, audit trail, fulfillment.
// Admin passwords are scrypt hashes; MFA (TOTP) is mandatory and its seed is stored encrypted (AES-256-GCM, key from env).
// Session tokens are random and only their SHA-256 is stored.
// ---------------------------------------------------------------------------
enum AdminRole {
  OWNER
  STAFF
}
model AdminUser {
  id String @id @default(cuid())
  email String @unique
  name String
  role AdminRole @default(STAFF)
  passwordHash String
  mfaSeedEnc String
  active Boolean @default(true)
  failedLogins Int @default(0)
  lockedUntil DateTime?
  lastLoginAt DateTime?
  // Highest TOTP time step already accepted for this admin (replay protection).
  lastTotpStep Int?
  createdAt DateTime @default(now())
  sessions AdminSession[]
  auditEvents AdminAuditEvent[]
}
model AdminSession {
  id String @id @default(cuid())
  adminId String
  admin AdminUser @relation(fields:[adminId], references:[id])
  tokenHash String @unique
  createdAt DateTime @default(now())
  lastSeenAt DateTime @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  ip String?
  userAgent String?
  @@index([adminId])
}
model AdminAuditEvent {
  id String @id @default(cuid())
  adminId String?
  admin AdminUser? @relation(fields:[adminId], references:[id])
  action String
  targetType String
  targetId String?
  detail Json?
  ip String?
  createdAt DateTime @default(now())
  @@index([targetType, targetId, createdAt])
  @@index([adminId, createdAt])
}
model Shipment {
  id String @id @default(cuid())
  orderId String
  order Order @relation(fields:[orderId], references:[id])
  carrier String
  trackingNumber String
  shippedAt DateTime @default(now())
  deliveredAt DateTime?
  createdByAdminId String?
  note String?
  @@unique([orderId, trackingNumber])
  @@index([orderId])
}
// Append-only history of an order: status changes and staff notes.
model OrderEvent {
  id String @id @default(cuid())
  orderId String
  order Order @relation(fields:[orderId], references:[id])
  kind String
  fromStatus OrderStatus?
  toStatus OrderStatus?
  note String?
  adminId String?
  createdAt DateTime @default(now())
  @@index([orderId, createdAt])
}

// ---------------------------------------------------------------------------
// Certificates of analysis (COAs). The outside lab's PDF is stored with its SHA-256; admins publish a version (OWNER only) which
// supersedes the previous published one. The hash (not the PDF or results) is anchored on Solana in a Memo (CoaAnchor).
// A published COA is the PUBLIC record for its lot; Lot.purity/coaKey are kept in sync on publish for existing readers.
// An anchor proves the document existed unchanged at a time and is linked to the lot; it does NOT prove the lab's results are true.
// ---------------------------------------------------------------------------
enum CoaStatus {
  DRAFT
  PUBLISHED
  SUPERSEDED
  REVOKED
}
enum AnchorKind {
  PUBLISH
  REVOKE
}
enum AnchorStatus {
  PENDING
  CONFIRMED
  FAILED
}
model Coa {
  id String @id @default(cuid())
  lotId String
  lot Lot @relation(fields:[lotId], references:[id])
  version Int
  status CoaStatus @default(DRAFT)
  labName String
  labReportId String
  testedAt DateTime @db.Date
  method String
  purityPercent Decimal @db.Decimal(5,2)
  notes String?
  fileName String
  fileSize Int
  fileSha256 String
  createdByAdminId String?
  createdAt DateTime @default(now())
  publishedByAdminId String?
  publishedAt DateTime?
  revokedByAdminId String?
  revokedAt DateTime?
  revokeReason String?
  file CoaFile?
  anchors CoaAnchor[]
  @@unique([lotId, version])
  @@index([fileSha256])
  @@index([lotId, status])
}
model CoaFile {
  coaId String @id
  coa Coa @relation(fields:[coaId], references:[id])
  bytes Bytes
}
model CoaAnchor {
  id String @id @default(cuid())
  coaId String
  coa Coa @relation(fields:[coaId], references:[id])
  kind AnchorKind
  memo String
  network String
  txSignature String? @unique
  status AnchorStatus @default(PENDING)
  slot BigInt?
  blockTime DateTime?
  error String?
  attempts Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([coaId, kind])
}
