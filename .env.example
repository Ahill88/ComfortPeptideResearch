DATABASE_URL=postgresql://helix:helix@localhost:5432/helix_field?schema=public
REDIS_HOST=localhost
REDIS_PORT=6379
STOREFRONT_ORIGIN=http://localhost:3000
SOLANA_USDC_TREASURY=

# --- Wallet / Research Credits (apps/api/src/wallet) -------------------------------------------
# Feature flags. Every flag defaults to false; leave false unless you have completed the
# corresponding review. Only the exact string "true" enables a flag.
# Use the real MoonPay widget (needs MOONPAY_* below). When false, on-ramp quotes are labeled sandbox simulations.
ENABLE_REAL_MOONPAY=false
# Allow the Solana adapter to run against mainnet (also needs SOLANA_NETWORK=solana-mainnet and SOLANA_USDC_MINT).
ENABLE_SOLANA_MAINNET=false
ENABLE_LIVE_CRYPTO_PAYMENTS=false
ENABLE_DELEGATED_PAYMENTS=false
ENABLE_LIVE_FULFILLMENT=false

# Chain adapter: "sandbox" (in-memory mock, refuses NODE_ENV=production) or "devnet" (real Solana RPC).
WALLET_CHAIN_MODE=sandbox
# Solana network for devnet mode: solana-devnet (default) or solana-mainnet (requires ENABLE_SOLANA_MAINNET=true).
SOLANA_NETWORK=solana-devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
# Required only for mainnet; devnet uses the built-in devnet USDC mint.
SOLANA_USDC_MINT=

# MoonPay on-ramp (only used when ENABLE_REAL_MOONPAY=true). Publishable key starts pk_test_ (MoonPay sandbox) or pk_live_.
# The secret key signs widget URLs server-side; never expose it to the browser or commit it.
MOONPAY_PUBLISHABLE_KEY=
MOONPAY_SECRET_KEY=

# Privy embedded wallets are NOT active unless configured. Setting this alone does not complete the integration.
PRIVY_APP_ID=

# --- Docker Compose / CI / deployment (infrastructure/**, docker-compose.yml) ------------------------------------------
# Used by docker-compose.yml only. `docker compose up` refuses to start without the POSTGRES_* values.
# These are throwaway LOCAL placeholders; never reuse them anywhere reachable from a network.
# The compose api container builds its own DATABASE_URL from these (URL-encode special characters in the password).
POSTGRES_USER=helix
POSTGRES_PASSWORD=helix
POSTGRES_DB=helix_field
# Disposable integration-test database (compose profile "test"), host port 54329. Name must contain "helix" or "test".
POSTGRES_TEST_DB=helix_field_test
POSTGRES_TEST_HOST_PORT=54329
# Host ports published (on 127.0.0.1 only) by docker compose.
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
API_HOST_PORT=3001
STOREFRONT_HOST_PORT=3000
ADMIN_HOST_PORT=3002
# API container NODE_ENV. Keep "development": NODE_ENV=production intentionally refuses to boot until real
# email verification / password reset / MFA exist (apps/api/src/auth/auth-startup.check.ts).
API_NODE_ENV=development
# The only switch that lets the API container apply `prisma migrate deploy` on start. Default false.
# One-off alternative: docker compose run --rm api migrate
RUN_MIGRATIONS=false
# Public API URL the BROWSER uses; inlined into the storefront bundle at image BUILD time (not a secret).
NEXT_PUBLIC_API_URL=http://localhost:3001/v1
# Shared secret for admin -> API calls. Leave EMPTY to keep admin endpoints denied. When set it must be >= 32 characters
# (e.g. `openssl rand -hex 32`); in any deployment it belongs in a secrets manager, never in this file.
ADMIN_API_TOKEN=

# Signs wallet-link challenges (proof of key control). Required (>= 32 chars) in any runtime other than
# NODE_ENV=development/test, where a random per-process key is generated if unset. Generate with: openssl rand -hex 32
WALLET_LINK_CHALLENGE_KEY=

# Customer eligibility gate on checkout prepare/submit. ENFORCED BY DEFAULT. Set to "false" to disable ONLY for local
# demos: it is honored only when NODE_ENV is exactly development or test and ignored (with a warning) everywhere else.
ELIGIBILITY_REQUIRED=true
