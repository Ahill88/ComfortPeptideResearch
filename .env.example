DATABASE_URL=postgresql://helix:helix@localhost:5432/helix_field?schema=public
REDIS_HOST=localhost
REDIS_PORT=6379
STOREFRONT_ORIGIN=http://localhost:3000
SOLANA_USDC_TREASURY=

# --- Wallet / Research Credits (apps/api/src/wallet) -------------------------------------------
# Feature flags. Every flag defaults to false; leave false unless you have completed the
# corresponding review. Only the exact string "true" enables a flag.
# Use the real MoonPay widget (needs MOONPAY_* below). When false, on-ramp quotes are labeled sandbox simulations.
ENABLE_REAL_MOONPAY=false
# MAINNET (real funds) needs BOTH of these exactly "true" plus WALLET_LIVE_ACKNOWLEDGED=I_ACCEPT_LIVE_FUNDS_RISK, NODE_ENV=production,
# SOLANA_NETWORK=solana-mainnet, an explicit SOLANA_RPC_URL and SOLANA_USDC_MINT; the API refuses to start otherwise. On solana-devnet
# (and in development/test) neither may be set. Checklist: docs/wallet/mainnet-readiness.md. NOT ready for real money today.
ENABLE_SOLANA_MAINNET=false
ENABLE_LIVE_CRYPTO_PAYMENTS=false
ENABLE_DELEGATED_PAYMENTS=false
ENABLE_LIVE_FULFILLMENT=false
# Explicit acknowledgement a live-funds flag above requires: the exact text I_ACCEPT_LIVE_FUNDS_RISK. Leave blank unless going live.
WALLET_LIVE_ACKNOWLEDGED=

# Chain adapter: "sandbox" (in-memory mock, refuses NODE_ENV=production) or "devnet" (real Solana RPC).
WALLET_CHAIN_MODE=sandbox
# "devnet" is the legacy name of the REAL RPC adapter: it serves whichever network SOLANA_NETWORK names (mainnet included).
# Solana network: solana-devnet (default) or solana-mainnet (see the flags above). At boot the API asks the RPC for its genesis hash and
# checks the USDC mint account (SPL Token program, 6 decimals, initialized); a wrong cluster or mint refuses to start, an unreachable
# RPC starts degraded (payments refused) and is re-checked every 30 s.
SOLANA_NETWORK=solana-devnet
# RPC endpoint. Devnet default below. Mainnet has NO default: set your own https endpoint (config only, never committed).
SOLANA_RPC_URL=https://api.devnet.solana.com
# THE one USDC mint for the configured network (checkout, verification, refunds, balances, transfers and the on-ramp all read it).
# Optional on devnet (built-in devnet mint); REQUIRED on mainnet: copy it from Circle's USDC contract-address page
# (https://developers.circle.com/stablecoins/usdc-contract-addresses). The repo deliberately does not hard-code it.
# SOLANA_USDC_MAINNET_MINT is DEPRECATED and ignored (startup warning if set); use only this variable.
SOLANA_USDC_MINT=

# MoonPay on-ramp (only used when ENABLE_REAL_MOONPAY=true). Publishable key starts pk_test_ (MoonPay sandbox) or pk_live_.
# A pk_live_ key is accepted only with SOLANA_NETWORK=solana-mainnet, a pk_test_ key only with solana-devnet (startup refuses a mismatch).
# The secret key signs widget URLs server-side; never expose it to the browser or commit it.
MOONPAY_PUBLISHABLE_KEY=
MOONPAY_SECRET_KEY=
# Webhook API key from the MoonPay dashboard (Developers page). NOT the URL-signing secret key above. Verifies the
# Moonpay-Signature-V2 header on POST /v1/webhooks/moonpay. Unset => the endpoint answers 503 and processes nothing.
MOONPAY_WEBHOOK_KEY=
# Allowed gap (seconds) between a webhook's signed timestamp and the server clock, either direction. Default 300.
MOONPAY_WEBHOOK_TOLERANCE_SECONDS=300

# Privy embedded wallets are NOT active unless configured. Setting this alone does not complete the integration.
PRIVY_APP_ID=

# --- Docker Compose / CI / deployment (infrastructure/**, docker-compose.yml) ------------------------------------------
# Used by docker-compose.yml only. `docker compose up` refuses to start without the POSTGRES_* values.
# These are throwaway LOCAL placeholders; never reuse them anywhere reachable from a network.
# The compose api container builds its own DATABASE_URL from these (URL-encode special characters in the password).
POSTGRES_USER=helix
POSTGRES_PASSWORD=helix
POSTGRES_DB=helix_field
# Disposable integration-test database (compose profile "test"), host port 54329. Name must contain "helix" or "test".
POSTGRES_TEST_DB=helix_field_test
POSTGRES_TEST_HOST_PORT=54329
# Host ports published (on 127.0.0.1 only) by docker compose.
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
API_HOST_PORT=3001
STOREFRONT_HOST_PORT=3000
ADMIN_HOST_PORT=3002
# API container NODE_ENV. Keep "development": NODE_ENV=production intentionally refuses to boot until real
# email verification / password reset / MFA exist (apps/api/src/auth/auth-startup.check.ts).
API_NODE_ENV=development
# The only switch that lets the API container apply `prisma migrate deploy` on start. Default false.
# One-off alternative: docker compose run --rm api migrate
RUN_MIGRATIONS=false
# Public API URL the BROWSER uses; inlined into the storefront bundle at image BUILD time (not a secret).
NEXT_PUBLIC_API_URL=http://localhost:3001/v1
# Shared secret for admin -> API calls. Leave EMPTY to keep admin endpoints denied. When set it must be >= 32 characters
# (e.g. `openssl rand -hex 32`); in any deployment it belongs in a secrets manager, never in this file.
ADMIN_API_TOKEN=

# Signs wallet-link challenges (proof of key control). Required (>= 32 chars) in any runtime other than
# NODE_ENV=development/test, where a random per-process key is generated if unset. Generate with: openssl rand -hex 32
WALLET_LINK_CHALLENGE_KEY=

# Customer eligibility gate on checkout prepare/submit. ENFORCED BY DEFAULT. Set to "false" to disable ONLY for local
# demos: it is honored only when NODE_ENV is exactly development or test and ignored (with a warning) everywhere else.
ELIGIBILITY_REQUIRED=true

# Checkout top-up (POST /v1/wallet/onramp/order-topup): how much the on-ramp asks a customer to buy when their
# Research Credits fall short of an order. MoonPay's fees reduce the USDC delivered and the provider does not quote
# them, so set the buffer from MoonPay's current fee schedule (the checkout re-checks the balance after the funds
# arrive and offers another top-up if still short). Invalid values stop the API from starting.
# Integer percent 0-100 added to the shortfall before rounding up to whole dollars. Default 0.
ONRAMP_FEE_BUFFER_PERCENT=0
# Smallest purchase in whole US dollars (= whole USDC). Default 1. MoonPay's usdc_sol minimum measured with a test key (2026-10-21) is
# 19.57 USDC, so use 20 when ENABLE_REAL_MOONPAY=true (re-check GET /v3/currencies/usdc_sol/limits?apiKey=... before going live).
ONRAMP_MIN_USD=1
# Largest single purchase in whole US dollars (a larger need is refused with 400). Default 10000, at most 1000000.
ONRAMP_MAX_USD=10000
# DEVELOPMENT/TEST ONLY (ignored in any other runtime): your machine's PUBLIC IP. When a browser on the same machine calls the API over
# localhost, MoonPay sees this public IP but the API sees ::1/127.0.0.1, so IP matching fails; this value is hashed instead.
ONRAMP_DEV_PUBLIC_IP=

# Platform-paid Solana network fee for wallet checkout ("Pay with Research Credits"). A customer who bought USDC through
# the fiat on-ramp holds no SOL, so with this ON Helix & Field pays the fee as the transaction's fee payer; the customer's
# own wallet still owns and signs the USDC transfer and withdrawals stay customer-paid. OFF by default.
# Only the exact string "true" turns it on; "false"/blank is off; anything else (TRUE, 1, yes) stops the API from starting.
# It needs a FEE_PAYER_SIGNER bound in CheckoutModule.register (a KMS/HSM-held key that holds only SOL for fees; the repo
# ships none, only a sandbox-only in-memory signer for the mock chain). With none bound the API logs a loud warning at
# startup and every customer pays the fee in SOL. See docs/wallet/custody-model.md and docs/wallet/go-live-checklist.md.
FEE_SPONSORSHIP=false
# If the fee payer's SOL balance is below this many lamports, sponsorship is unavailable and checkout falls back to
# customer-pays. Whole lamports, 1 to 1000000000000000. Default 50000000 (0.05 SOL).
FEE_SPONSOR_MIN_LAMPORTS=50000000
# Most sponsored checkouts one customer may start in any rolling 24 hours (counted from CHECKOUT_FEE_SPONSORED audit
# events); beyond it checkout falls back to customer-pays. Whole number 1 to 10000. Default 20.
FEE_SPONSOR_MAX_PER_CUSTOMER_DAY=20

# Back-office (admin) sign-in: encrypts every admin's MFA seed at rest (AES-256-GCM). REQUIRED, >= 32 characters, for admin sign-in and
# `pnpm --filter @helix-field/api admin:create`. Unset or short => POST /v1/admin/auth/login answers 503 and nothing else is affected.
# Generate with: openssl rand -base64 32. Keep it in a secrets manager; changing it makes existing admins' MFA seeds unreadable. See docs/api/admin-auth.md.
ADMIN_MFA_ENCRYPTION_KEY=

# Customer accounts (docs/api/customer-auth.md): encrypts each customer's optional MFA seed at rest (AES-256-GCM, HKDF-derived, a different
# domain from the admin key). >= 32 characters. Unset => POST /v1/auth/mfa/enroll answers 503 and sign-in for customers without MFA is unaffected;
# set but shorter than 32 characters => a production-like runtime refuses to start. Generate with: openssl rand -base64 32.
# The same API also reads STOREFRONT_PUBLIC_URL (below) as the base of emailed verification/reset links: required in production-like runtimes
# (else POST /v1/auth/register answers 503 "Account email is not configured."), localhost:3000 fallback in development/test only.
# Cookie sessions also need STOREFRONT_ORIGIN (above): the CSRF Origin check uses the same allow-list as CORS.
CUSTOMER_MFA_ENCRYPTION_KEY=

# Certificate-of-analysis gate. Only the exact string "true" turns it on (anything else is off): products then list only lots that have a
# PUBLISHED COA, POST /v1/orders rejects a lot without one (400 "Unavailable product in order") and publishing a product needs such a lot.
# Default false so the preview seed (placeholder lots with no COA) keeps working. PRODUCTION MUST SET THIS TO true once real COAs exist.
# See docs/api/coa-verification.md.
REQUIRE_PUBLISHED_COA=false

# On-chain anchoring of certificate-of-analysis (COA) hashes in a Solana Memo transaction (docs/api/coa-anchoring.md). SEPARATE from the
# payment chain: anchoring on mainnet does NOT enable payments. Parsed strictly at startup: a bad value stops the API from starting.
# Only the exact string "true" turns it on (default off: COAs publish without anchors). It also needs a COA_PUBLISHER_SIGNER bound
# in CoaAnchorModule (a KMS/HSM-held dedicated key holding a few dollars of SOL; the repo ships none). Without one anchors stay PENDING.
COA_ANCHOR_ENABLED=false
# "solana-devnet" (default) or "solana-mainnet".
COA_ANCHOR_NETWORK=solana-devnet
# Required, explicit and https for solana-mainnet (use your own RPC provider; there is no default). Optional for devnet (default: the public devnet endpoint).
COA_ANCHOR_RPC_URL=
# How often (ms) the verifier re-reads pending anchors from the chain; 0 disables the sweep. Default 60000.
COA_ANCHOR_RECONCILE_INTERVAL_MS=60000
# Dev launcher only (tools/dev/api-devnet-sponsored.ts): JSON keypair file of a throwaway, devnet-funded COA publisher key. Never a real key.
DEV_COA_PUBLISHER_KEYPAIR_FILE=
# Dev launcher only: JSON keypair file of a throwaway devnet key that IS the merchant treasury (its public key must equal SOLANA_USDC_TREASURY or
# the launcher refuses). Binds MERCHANT_SIGNER so admin refund submit works on devnet. Unset => submit answers 503. See docs/api/admin-refunds.md.
DEV_TREASURY_KEYPAIR_FILE=

# Admin app only (server-side): the public storefront address printed as the lot verification address on packing slips, e.g. https://shop.example.com
STOREFRONT_PUBLIC_URL=

# Transactional email (docs/api/email.md). EMAIL_PROVIDER: "console" (default in development/test: logs one redacted line per message and writes
# the full message to EMAIL_DEV_OUTBOX_DIR so you can open verification links), "resend" (Resend REST API), or "none" (default in every other
# runtime: mail is stored in the outbox but NOT sent, with a loud startup warning). Blank = that default. "resend" REQUIRES EMAIL_API_KEY and
# EMAIL_FROM (a@example.com or Name <a@example.com>, on a domain verified in Resend), or the API refuses to start. Keep EMAIL_API_KEY out of git.
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=
# Outbox worker poll interval in ms: 0 disables the worker, otherwise 100..3600000. Default 5000.
EMAIL_WORKER_INTERVAL_MS=5000
# Development/test only (ignored elsewhere). Default /tmp/helix-dev-mail.
EMAIL_DEV_OUTBOX_DIR=

# Sanctions address screening (docs/compliance/sanctions-screening.md). Wallet link, on-ramp, transfer and checkout refuse a wallet address that
# is a "Digital Currency Address" entry of the public OFAC SDN list (403 "This wallet cannot be used."). Address screening only: NOT name/country screening.
# Source (default is the Treasury/OFAC Sanctions List Service SDN export, legacy XML; https only outside development/test):
SANCTIONS_LIST_URL=https://sanctionslistservice.ofac.treas.gov/api/PublicationPreview/exports/SDN.XML
# Hours between automatic refreshes (checked at startup and every 15 min; a refresh runs only when the last good run is older). Whole number 0..2160.
# Default 24. 0 turns the automatic job off entirely (use POST /v1/admin/compliance/sanctions/refresh as OWNER). Never runs in NODE_ENV=test unless SANCTIONS_REFRESH_IN_TEST=true.
SANCTIONS_REFRESH_HOURS=24
# enforce (default) or off. "off" is honoured ONLY in development/test; in every other runtime it is ignored with a startup warning.
# Until the list has loaded once, development/test let wallets through with a warning and every other runtime answers 503 "Compliance screening is not ready.".
SANCTIONS_SCREENING=enforce

# Order totals, stock holds and the unpaid-order sweep (docs/api/inventory-and-totals.md). All whole numbers; a malformed or out-of-range value
# stops the API from starting (nothing falls back silently). Blank = the default.
# Flat shipping charge in cents (0..2147483647). Default 0 (no shipping charge).
SHIPPING_FLAT_CENTS=
# Subtotals strictly ABOVE this many cents ship free. Unset (default) = shipping is never free. 0 is a real threshold, not "unset".
SHIPPING_FREE_OVER_CENTS=
# Flat tax placeholder in basis points of the subtotal, rounded half-up (825 = 8.25%). 0..10000, default 0 = no tax. NOT a tax engine: see the doc.
TAX_RATE_BPS=
# How long an unpaid order holds its stock, in minutes (1..10080). Default 60.
ORDER_HOLD_MINUTES=
# Unpaid-order sweep period in ms (0..86400000). Default 60000. 0 disables the sweep on this instance (other instances can still run it).
ORDER_SWEEP_INTERVAL_MS=
